services:
  db:
    image: pgvector/pgvector:pg16
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-lawai}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-lawai}
      POSTGRES_DB: ${POSTGRES_DB:-irish_law}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./database/init:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U ${POSTGRES_USER:-lawai} -d ${POSTGRES_DB:-irish_law}
      interval: 5s
      timeout: 5s
      retries: 10

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    restart: unless-stopped
    environment:
      DATABASE_URL: postgresql://${POSTGRES_USER:-lawai}:${POSTGRES_PASSWORD:-lawai}@db:5432/${POSTGRES_DB:-irish_law}
    ports:
      - "8000:8000"
    depends_on:
      db:
        condition: service_healthy

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    restart: unless-stopped
    environment:
      BACKEND_URL: http://backend:8000
      NEXT_PUBLIC_API_URL: http://localhost:8000
    ports:
      - "3000:3000"
    depends_on:
      - backend

  ingest:
    build:
      context: ./backend
      dockerfile: Dockerfile
    profiles:
      - ingest
    environment:
      DATABASE_URL: postgresql://${POSTGRES_USER:-lawai}:${POSTGRES_PASSWORD:-lawai}@db:5432/${POSTGRES_DB:-irish_law}
      PYTHONPATH: /app
    volumes:
      - ./backend/ingest:/app/ingest:ro
      - ./data:/app/data
    depends_on:
      db:
        condition: service_healthy
    entrypoint:
      - python
      - -m
      - ingest.cli

volumes:
  postgres_data:
